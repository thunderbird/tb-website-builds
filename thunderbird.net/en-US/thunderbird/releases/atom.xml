    <title type="html">Thunderbird 153.6.0esr</title>
    <author>
      <name>Thunderbird</name>
      <uri>https://www.thunderbird.net</uri>
    </author>
    <link rel="alternate" type="text/html" href="https://www.thunderbird.net/en-US/thunderbird/153.6.0esr/releasenotes/"/>
